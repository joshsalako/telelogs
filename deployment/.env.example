# vLLM server identity and address
QWEN_VLLM_MODEL=Qwen/Qwen3.6-27B
QWEN_VLLM_SERVED_MODEL_NAME=Qwen3.6-27B
QWEN_VLLM_HOST=127.0.0.1
QWEN_VLLM_PORT=8000

# Single-GPU memory and concurrency controls
QWEN_VLLM_TENSOR_PARALLEL_SIZE=1
QWEN_VLLM_MAX_MODEL_LEN=16384
QWEN_VLLM_GPU_MEMORY_UTILIZATION=0.90
QWEN_VLLM_MAX_NUM_SEQS=8

# Qwen/vLLM behavior
QWEN_VLLM_REASONING_PARSER=qwen3
QWEN_VLLM_QUANTIZATION=bitsandbytes

# Optional. When set, clients must send this as a Bearer token.
# QWEN_VLLM_API_KEY=

# Optional Hugging Face authentication and cache locations.
# HF_TOKEN=
# HF_HOME=/path/to/huggingface
# HUGGINGFACE_HUB_CACHE=/path/to/huggingface/hub

# Health-check request timeout.
QWEN_VLLM_CHECK_TIMEOUT_SECONDS=30
